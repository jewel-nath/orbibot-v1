<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orbibot_agent</name>
  <version>0.1.0</version>
  <description>Unified AI agent for OrbiBot - Multi-LLM support with Web GUI, Terminal, and MCP interfaces</description>
  <maintainer email="dev@orbibot.com">OrbiBot Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>orbibot_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs_py</depend>

  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-aiohttp-cors</exec_depend>
  <exec_depend>python3-google-generativeai</exec_depend>
  <exec_depend>python3-anthropic</exec_depend>
  <exec_depend>python3-openai</exec_depend>
  <exec_depend>python3-mcp</exec_depend>
  <exec_depend>python3-pyyaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>