<?xml version="1.0"?>
<!-- orbibot.urdf.xacro - OrbiBot URDF robot model -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="orbibot">

  <!-- Robot Parameters -->
  <!-- Native ${pi} used throughout instead of custom PI property -->
  
  <!-- Wheel specifications -->
  <xacro:property name="wheel_radius" value="0.05"/>           <!-- 100mm diameter = 50mm radius -->
  <xacro:property name="track_width" value="0.36"/>            <!-- Total left-right wheel separation -->
  <xacro:property name="wheelbase" value="0.26"/>              <!-- Total front-back wheel separation -->
  
  <!-- Base dimensions -->
  <xacro:property name="base_length" value="0.35"/>
  <xacro:property name="base_width" value="0.25"/>
  <xacro:property name="base_height" value="0.10"/>
  <xacro:property name="base_mass" value="6.0"/>
  
  <!-- Sensor positions -->
  <xacro:property name="lidar_height" value="0.18"/>
  <xacro:property name="camera_height" value="0.02"/>

  <!-- Inertia macros -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <!-- Base footprint -->
  <link name="base_footprint"/>

  <!-- Base joint -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_material">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <!-- Mecanum wheel macro -->
  <xacro:macro name="mecanum_wheel" params="prefix x_pos y_pos rpy_val axis_val mesh_file">
    
    <!-- Wheel joint -->
    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="${x_pos} ${y_pos} 0.0" rpy="${rpy_val}"/>
      <axis xyz="${axis_val}"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Wheel link -->
    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://orbibot_description/meshes/${mesh_file}" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="wheel_material">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.05" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="0.05"/>
      </inertial>
    </link>

  </xacro:macro>

  <!-- Wheel instantiation (ordered to match hardware M1-M4) -->
  <!-- Left wheels: standard orientation with +Z rotation axis -->
  <xacro:mecanum_wheel prefix="front_left"  x_pos="${wheelbase/2}"  y_pos="${track_width/2}"  rpy_val="${-pi/2} 0 0" axis_val="0 0 1"  mesh_file="mechanical-wheel-FrontLeft-BackRight.stl"/>
  <xacro:mecanum_wheel prefix="back_left"   x_pos="${-wheelbase/2}" y_pos="${track_width/2}"  rpy_val="${-pi/2} 0 0" axis_val="0 0 1"  mesh_file="mechanical-wheel-FrontRight-BackLeft.stl"/>
  <!-- Right wheels: flipped coordinate frame requires -Z rotation axis -->
  <xacro:mecanum_wheel prefix="front_right" x_pos="${wheelbase/2}"  y_pos="${-track_width/2}" rpy_val="${pi/2} 0 0"  axis_val="0 0 -1" mesh_file="mechanical-wheel-FrontRight-BackLeft.stl"/>
  <xacro:mecanum_wheel prefix="back_right"  x_pos="${-wheelbase/2}" y_pos="${-track_width/2}" rpy_val="${pi/2} 0 0"  axis_val="0 0 -1" mesh_file="mechanical-wheel-FrontLeft-BackRight.stl"/>

  <!-- RPLIDAR A1 -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="-0.03 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://orbibot_description/meshes/RPLidar-A1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lidar_material">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <xacro:cylinder_inertia m="0.2" r="0.035" h="0.04"/>
    </inertial>
  </link>

  <!-- Intel RealSense D435 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2} 0.0 ${camera_height}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="camera_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.072"/>
      <xacro:box_inertia m="0.072" x="0.025" y="0.09" z="0.025"/>
    </inertial>
  </link>

  <!-- Camera optical frames for RealSense -->
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0.0 -0.046 0.004" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_color_optical_frame"/>

  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.0 -0.0175 0.004" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- IMU sensor -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.005"/>
      </geometry>
      <material name="imu_material">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.005"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <xacro:box_inertia m="0.005" x="0.015" y="0.015" z="0.005"/>
    </inertial>
  </link>

  <!-- ============================================================ -->
  <!-- Gazebo Harmonic Simulation Plugins                           -->
  <!-- These tags are ignored on the real robot (no Gazebo running) -->
  <!-- ============================================================ -->

  <!-- Differential drive — mecanum approximation (no lateral strafe in sim) -->
  <!-- Publishes /odom + odom→base_footprint TF, subscribes /cmd_vel        -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_back_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_back_right_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint state publisher — publishes wheel positions for RViz -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_back_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_back_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- RPLidar A1 simulation (360° ray sensor, 10 Hz, 0.15–12m) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- IMU sensor simulation (50 Hz with Gaussian noise) -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/data_raw</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Wheel friction properties (improves sim driving feel) -->
  <gazebo reference="wheel_front_left_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_back_left_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_front_right_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_back_right_link">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>