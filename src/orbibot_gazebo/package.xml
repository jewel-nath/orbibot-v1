<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orbibot_gazebo</name>
  <version>1.0.0</version>
  <description>Gazebo Harmonic simulation for OrbiBot — world, spawn, and ROS-Gazebo bridge</description>
  <maintainer email="jewel.nath@orbitax.com">Jewel Nath</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Launch and description -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>orbibot_description</depend>

  <!-- Gazebo Harmonic (gz-sim 8) -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_interfaces</depend>

  <!-- Simulation launch orchestration -->
  <depend>orbibot_slam</depend>
  <depend>orbibot_navigation</depend>
  <depend>orbibot_exploration</depend>
  <depend>nav2_bringup</depend>

  <!-- ROS packages used in bridge -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>rosgraph_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
